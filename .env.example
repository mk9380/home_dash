# Network
HOST_IP=192.168.1.100        # set this to your machine's local IP address
SERVER_PORT=3001

# AI provider — set to "anthropic" or "ollama"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=           # required if AI_PROVIDER=anthropic
OLLAMA_MODEL=llama3          # required if AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
